{
  "name": "ingestarr",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.7",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check:clean-desktop": "node scripts/check-clean-desktop-command.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "make": "pnpm --filter @ingestarr/desktop make",
    "package": "pnpm --filter @ingestarr/desktop package",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs",
    "pretest": "pnpm --filter @ingestarr/desktop rebuild:native:node",
    "test": "pnpm --filter @ingestarr/shared-types test:built && vitest run",
    "typecheck": "pnpm --filter './packages/*' build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "prettier": "latest",
    "playwright": "latest",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
